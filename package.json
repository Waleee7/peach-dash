{
  "name": "peach-dash",
  "version": "1.0.0",
  "description": "PEACH DASH - a 3D endless runner through a low-poly Atlanta, Georgia. Dodge, jump, slide, grab peaches.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run"
  },
  "keywords": ["endless-runner", "threejs", "webgl", "game", "atlanta", "low-poly", "typescript", "vite"],
  "dependencies": {
    "@fontsource/bungee": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
